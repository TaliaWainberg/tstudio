---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<section class="band" aria-label={d.band.label}>
  <div class="wrap inner">
    <div class="num" aria-hidden="true">0.05</div>
    <div>
      <p><span class="sr-only">0.05 </span>{d.band.text}</p>
      <span class="caps" dir="ltr" lang="en">{d.band.caps}</span>
    </div>
  </div>
</section>
