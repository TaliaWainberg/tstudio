---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<section id="process" aria-labelledby="process-title">
  <div class="sec-head">
    <span class="caps" dir="ltr" lang="en">{d.process.eyebrow}</span>
    <h2 id="process-title">{d.process.title}</h2>
  </div>
  <ol class="steps">
    {d.process.steps.map((s) => (
      <li class="step">
        <span class="caps" dir="ltr" lang="en">{s.caps}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>
