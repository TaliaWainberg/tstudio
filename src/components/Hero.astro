---
import { Picture } from 'astro:assets';
import card from '../assets/card-photo-hires.jpg';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<div class="hero">
  <div class="hero-text">
    <h1>{d.hero.title}</h1>
    <p class="lede">{d.hero.lede.pre}<span dir="ltr" lang="en">{d.hero.lede.ltr}</span>{d.hero.lede.post}</p>
    <div class="cta-row">
      <a class="btn" href="#contact">{d.hero.cta}</a>
    </div>
  </div>
  <div class="hero-img">
    <Picture
      src={card}
      alt={d.hero.imageAlt}
      formats={['avif', 'webp']}
      widths={[400, 640, 820, 1040, 1254]}
      sizes="(max-width: 820px) calc(100vw - 32px), min(530px, 45vw)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</div>
