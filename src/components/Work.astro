---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ExtLink from './ExtLink.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" aria-labelledby="work-title">
  <div class="sec-head">
    <h2 id="work-title">{d.work.title}</h2>
  </div>
  <div class="work-rows">
    {projects.map(({ data: p }, i) => (
      <article class:list={["project-row", { "is-reversed": i % 2 === 1 }]}>
        <div class="project-media">
          <div class="frame">
            <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="screen">
              {p.video ? (
                <video
                  class="shot-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={p.video.poster}
                  aria-label={p.imageAlt?.[locale] ?? p.title}
                  data-mp4={p.video.mp4}
                  data-webm={p.video.webm}
                ></video>
              ) : p.image ? (
                <Image
                  class="shot-img"
                  src={p.image}
                  alt={p.imageAlt?.[locale] ?? p.title}
                  widths={[480, 720, 960, 1280]}
                  sizes="(max-width: 820px) calc(100vw - 32px), 640px"
                />
              ) : (
                <div class="shot-empty"><strong dir="ltr" lang="en">{p.title}</strong></div>
              )}
            </div>
          </div>
          {p.mobileVideo && (
            <div class="frame frame-mobile" aria-hidden="true">
              <div class="screen">
                <video
                  class="shot-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={p.mobileVideo.poster}
                  data-mp4={p.mobileVideo.mp4}
                  data-webm={p.mobileVideo.webm}
                ></video>
              </div>
            </div>
          )}
        </div>
        <div class="project-info">
          <span class="caps project-name" dir="ltr" lang="en">{p.title}</span>
          <p>{p.description[locale]}</p>
          {p.tags.length > 0 && (
            <span class="caps tags" dir="ltr" lang="en">{p.tags.join(' · ')}</span>
          )}
          {p.url && <ExtLink class="link" href={p.url} label={d.work.visit} locale={locale} />}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // Lazy-load each project video when its row nears the viewport, then autoplay it.
  // Under prefers-reduced-motion we never load sources, so only the poster shows (static).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('#work .shot-video'));

  if (vids.length && !reduce && 'IntersectionObserver' in window) {
    const load = (v: HTMLVideoElement) => {
      if (v.dataset.loaded) return;
      v.dataset.loaded = '1';
      const add = (type: string, src?: string) => {
        if (!src) return;
        const s = document.createElement('source');
        s.src = src;
        s.type = type;
        v.appendChild(s);
      };
      add('video/webm', v.dataset.webm);
      add('video/mp4', v.dataset.mp4);
      v.load();
      v.play().catch(() => {}); // ignore autoplay rejections (video stays on its poster)
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            load(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '200px' },
    );
    vids.forEach((v) => io.observe(v));
  }
</script>
