---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import ExtLink from './ExtLink.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" aria-labelledby="work-title">
  <div class="sec-head">
    <span class="caps" dir="ltr" lang="en">{d.work.eyebrow}</span>
    <h2 id="work-title">{d.work.title}</h2>
  </div>
  <div class="work">
    {projects.map(({ data: p }) => (
      <article class="project">
        <div class="frame" aria-hidden={p.image ? undefined : 'true'}>
          <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
          {p.image ? (
            <div class="shot has-img">
              <Image src={p.image} alt={p.imageAlt?.[locale] ?? p.title} widths={[480, 720, 960, 1280]} sizes="(max-width: 820px) calc(100vw - 32px), 640px" />
            </div>
          ) : (
            <div class="shot"><strong dir="ltr" lang="en">{p.title}</strong><span class="caps" dir="ltr" lang="en">{p.kind}</span></div>
          )}
        </div>
        <h3 lang="en">{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}<span class="sr-only" lang={locale}> {d.newTab}</span></a> : p.title}</h3>
        <p>{p.description[locale]}</p>
        {p.url && <ExtLink class="link" href={p.url} label={d.work.visit} locale={locale} />}
      </article>
    ))}
    <a class="next" href="#contact">
      <span class="caps" dir="ltr" lang="en">{d.work.nextCaps}</span>
      <h3>{d.work.nextTitle}</h3>
      <span class="link"><Arrow label={d.work.nextLink} /></span>
    </a>
  </div>
</section>
