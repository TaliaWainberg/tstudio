---
import Marquee from './Marquee.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<section id="services" aria-labelledby="services-title">
  <Marquee text={d.services.eyebrow} />
  <div class="sec-head">
    <h2 id="services-title">{d.services.title}</h2>
  </div>
  <div class="services">
    {d.services.items.map((s) => (
      <div class="service">
        <span class="caps" dir="ltr" lang="en">{s.caps}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
</section>
