# Copy to .env for local builds, and set the same variables in Vercel → Settings → Environment Variables.

# Full site URL, no trailing slash. Used for canonical URLs, hreflang, Open Graph, sitemap and robots.txt.
SITE_URL=https://your-domain.co.il

# Contact form (Web3Forms by default): get a free access key at https://web3forms.com
# with the email that should receive submissions, and paste it here.
PUBLIC_FORM_ACCESS_KEY=

# Optional: use Formspree instead → PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id
PUBLIC_FORM_ENDPOINT=
